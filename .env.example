# Application
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME=TextProcessor
STACK_NAME=textprocessor
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"

# Authentication
SECRET_KEY=replace-with-a-long-random-secret
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Email
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

# Optional observability
SENTRY_DSN=

# Application images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Docling Serve v1.28.0 CPU multi-architecture index, pinned by digest.
DOCLING_BASE_IMAGE=quay.io/docling-project/docling-serve-cpu:v1.28.0@sha256:cc207e1eb768878456ed98042c5d84fae56af3729a9c03d3e5c8fef393902956
DOCKER_IMAGE_DOCLING=docling-service
DOCLING_SERVE_API_KEY=replace-with-a-long-random-api-key
DOCLING_MAX_FILE_SIZE_BYTES=104857600
DOCLING_MAX_NUM_PAGES=500
DOCLING_MAX_DOCUMENT_TIMEOUT_SECONDS=3600

# TextProcessor connects only to Docling's HTTP API, never its Redis.
# Celery and Docling RQ share one internal-only Redis instance but use separate
# logical databases. This separates keys, not resources or failure domains.
CELERY_BROKER_URL=redis://redis:6379/0
# Docling RQ is fixed to redis://redis:6379/1 by compose.docling.yml.
# Must cover the longest normal task; smoke environments may use a shorter value.
CELERY_BROKER_VISIBILITY_TIMEOUT_SECONDS=3660
EXTRACTION_DOCLING_BASE_URL=http://docling:5001
EXTRACTION_DOCLING_API_KEY=replace-with-the-same-docling-api-key

# Systemd or other non-Compose deployments configure the nested worker settings
# directly. Keep the value as a JSON array; comma-separated text is invalid.
EXTRACTION_WORKER__MINERU_BASE_URL=http://127.0.0.1:9000
EXTRACTION_WORKER__MINERU_API_KEY=
EXTRACTION_WORKER__DOCLING_BASE_URL=http://127.0.0.1:5001
EXTRACTION_WORKER__DOCLING_API_KEY=replace-with-a-runtime-secret
EXTRACTION_WORKER__PRODUCTION_FORMATS=["text","markdown","json","xml","yaml","csv","tsv","pdf","image","pptx","xlsx","docx","html","epub"]

# Classification Service is internal-only and mounts an immutable release read-only.
DOCKER_IMAGE_CLASSIFICATION=classification-service
CLASSIFICATION_ENVIRONMENT=development
CLASSIFICATION_INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-internal-token
CLASSIFICATION_MODEL_ROOT=C:/models/classification/releases
CLASSIFICATION_MODEL_RELEASE=20260729T093134Z-321175f0
CLASSIFICATION_MODEL_RELEASE_SHA256=replace-with-64-lowercase-hex-manifest-sha256
CLASSIFICATION_RELEASE_QUALITY_STATUS=experimental
CLASSIFICATION_NVIDIA_VISIBLE_DEVICES=0

# Data-Juicer is internal-only. It uses Redis DB 2 and the shared PostgreSQL DB.
DOCKER_IMAGE_DATAJUICER=datajuicer-service
